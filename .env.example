# === OpenRouter (бесплатная модель) ===
# Получить ключ: https://openrouter.ai/keys  (формат sk-or-...)
OPENROUTER_API_KEY=sk-or-REPLACE_ME

# Модель: free + поддержка tools + контекст >= 64K.
# Перепроверить актуальность перед запуском:
#   https://openrouter.ai/models?max_price=0&supported_parameters=tools&order=context-high-to-low
# Дефолт и бэкапы (на июнь 2026):
#   openai/gpt-oss-120b:free            (131K)  <- дефолт
#   nvidia/nemotron-3-ultra-550b-a55b:free (1M)
#   poolside/laguna-m.1:free            (262K)
#   nex-agi/nex-n2-pro:free             (262K)
HERMES_MODEL=openai/gpt-oss-120b:free

# === Telegram ===
# Токен бота от @BotFather:
TELEGRAM_BOT_TOKEN=123456789:REPLACE_ME
# Разрешённые пользователи (числовые id через запятую; узнать id — @userinfobot):
TELEGRAM_ALLOWED_USERS=000000000

# === Habr (источник; менять обычно не нужно) ===
HABR_BASE_URL=https://habr.com